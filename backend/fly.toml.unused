# 이 파일은 쓰지 않습니다 — 지우기 전 보관용.
#
# backend/Dockerfile 이 COPY backend/requirements.txt 를 하기 때문에 빌드 기준
# 폴더가 저장소 루트여야 합니다. 이 폴더에서 flyctl deploy 를 돌리면
# backend/backend/requirements.txt 를 찾다가 실패합니다 — 즉 이 설정으로는
# 배포가 아예 되지 않습니다.
#
# 여기 적혀 있던 설정(CHAT_MODEL · ADMIN_COOKIE_SECURE 등)은 루트 fly.toml 로
# 옮겼습니다. DATA_DIR 은 fly secrets 에 들어 있습니다.
#
# 배포는 늘 저장소 루트에서:  flyctl deploy

app = "project-summary-mkoo"
primary_region = "nrt"

[build]
  dockerfile = "Dockerfile"

[env]
  PORT = "8080"   # Dockerfile CMD / internal_port 와 일치해야 함
  DATA_DIR = "/data"
  ADMIN_COOKIE_SECURE = "true"
  # 챗봇 답변 모델 (gpt-4o = 품질 우선 / gpt-4o-mini = 비용 우선)
  CHAT_MODEL = "gpt-4o"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

[[mounts]]
  source = "data"
  destination = "/data"

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
  cpus = 1
